    {
      "parameters": {
        "jsCode": "// Build the night Q1 message with reply keyboard\n// If today's morning targets not found, use '?'\nconst nightData = $('Prepare Night Data').first().json;\nlet slotsTarget = '?';\nlet hoursTarget = '?';\ntry {\n  const sheetRow = $input.first().json;\n  slotsTarget = sheetRow['Slots Target'] || '?';\n  hoursTarget = sheetRow['Hours Target'] || '?';\n} catch(e) {}\n\nreturn [{\n  json: {\n    chat_id: nightData.chat_id,\n    text: `🌙 Good Evening, ${nightData.student_name}! 🌙\\nDay *${nightData.day_number}* \\u2014 Quick report time.\\n\\nDid you hit your targets today?\\n_(You targeted: ${slotsTarget} slots, ${hoursTarget}h)_`,\n    parse_mode: 'Markdown',\n    reply_markup: {\n      keyboard: [\n        [\n          { text: '\\u2705 Done' },\n          { text: '\\u26a0\\ufe0f Partially' }\n        ],\n        [\n          { text: '\\u274c Not Done' }\n        ]\n      ],\n      one_time_keyboard: true,\n      resize_keyboard: true\n    },\n    today_date: nightData.today_date,\n    student_name: nightData.student_name,\n    telegram_chat_id: nightData.telegram_chat_id\n  }\n}];"
      },

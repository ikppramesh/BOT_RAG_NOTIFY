    {
      "parameters": {
        "jsCode": "// Calculate day number and today's IST date\nconst student = $input.first().json;\nconst startDateStr = student['start_date'] || student['start date'] || '';\nlet dayNumber = '?';\nif (startDateStr) {\n  const parts = startDateStr.split('/');\n  let startDate;\n  if (parts.length === 3) {\n    startDate = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));\n  } else {\n    startDate = new Date(startDateStr);\n  }\n  if (!isNaN(startDate.getTime())) {\n    const diffMs = new Date() - startDate;\n    dayNumber = Math.floor(diffMs / (1000 * 60 * 60 * 24)) + 1;\n  }\n}\n\nconst istOffset = 5.5 * 60 * 60 * 1000;\nconst now = new Date();\nconst istNow = new Date(now.getTime() + istOffset);\nconst dd = String(istNow.getUTCDate()).padStart(2, '0');\nconst mm = String(istNow.getUTCMonth() + 1).padStart(2, '0');\nconst yyyy = istNow.getUTCFullYear();\nconst todayIST = `${dd}/${mm}/${yyyy}`;\n\nreturn [{\n  json: {\n    ...student,\n    day_number: dayNumber,\n    chat_id: String(student['telegram_chat_id']),\n    today_date: todayIST\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "// Keep only items not already logged as ingested (dedup by link/guid)\nconst feedMeta = $('Loop Over Feeds').first().json;\nconst loggedRows = $('Read RSS Ingested Log').all().map(i => i.json);\nconst loggedGuids = new Set(loggedRows.map(r => String(r.guid || '')));\n\nconst items = $input.all().map(i => i.json);\nconst newItems = items.filter(it => {\n  const guid = it.guid || it.link || it.id || '';\n  return guid && !loggedGuids.has(String(guid));\n});\n\nconst today = new Date().toISOString().slice(0, 10);\nreturn newItems.map(it => {\n  const guid = String(it.guid || it.link || it.id || '');\n  const summary = (it.contentSnippet || it.content || it.summary || '').toString().trim();\n  return {\n    json: {\n      guid,\n      text: `${it.title || ''}. ${summary}`.trim(),\n      source_doc: it.title || guid,\n      subject: feedMeta.subject_tag || 'Current Affairs',\n      doc_type: 'current_affairs',\n      uploaded_at: today,\n      link: it.link || ''\n    }\n  };\n});"
      },

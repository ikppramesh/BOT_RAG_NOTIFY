      "id": "extract-pdf-text",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "jsCode": "// Chunk extracted PDF text into ~500-word windows with 50-word overlap.\n// Derives subject/doc_type tags from the filename — encourage mentors to\n// name files like \"GS2_Polity_Syllabus.pdf\" so subject tagging works well.\nconst fileMeta = $('Loop Over New Files').first().json;\nconst fileName = fileMeta.file_name || 'unknown_file';\nconst text = (($input.first().json.text) || '').replace(/\\s+/g, ' ').trim();\n\nconst baseName = fileName.replace(/\\.[^.]+$/, '');\nconst parts = baseName.split(/[_-]/);\nconst subject = parts[0] || 'General';\nconst lowerName = fileName.toLowerCase();\nlet docType = 'material';\nif (lowerName.includes('syllabus')) docType = 'syllabus';\nelse if (lowerName.includes('pyq')) docType = 'pyq';\nelse if (lowerName.includes('note')) docType = 'notes';\n\nconst words = text.split(' ').filter(Boolean);\nconst chunkSize = 500;\nconst overlap = 50;\nconst chunks = [];\nfor (let i = 0; i < words.length; i += (chunkSize - overlap)) {\n  const chunkWords = words.slice(i, i + chunkSize);\n  if (chunkWords.length === 0) break;\n  chunks.push(chunkWords.join(' '));\n  if (i + chunkSize >= words.length) break;\n}\n\nconst today = new Date().toISOString().slice(0, 10);\nreturn chunks.map((chunkText, idx) => ({\n  json: {\n    text: chunkText,\n    source_doc: fileName,\n    subject,\n    doc_type: docType,\n    uploaded_at: today,\n    chunk_index: idx\n  }\n}));"
      },
      "id": "chunk-document",
      "name": "Chunk & Tag Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, -100]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://api.voyageai.com/v1/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: [$json.text], model: 'voyage-3-lite', input_type: 'document' }) }}",
        "options": {}
      },
      "id": "embed-doc-chunk",
      "name": "Embed Document Chunk — Voyage AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_VOYAGE_CRED_ID",
          "name": "Voyage AI API (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build a Qdrant point from the embedding response + the chunk metadata\n// carried on the upstream 'Chunk & Tag Document' node.\nfunction uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst meta = $('Chunk & Tag Document').first().json;\nconst embedding = $json.data[0].embedding;\n\nreturn [{\n  json: {\n    id: uuidv4(),\n    vector: embedding,\n    payload: {\n      text: meta.text,\n      source_doc: meta.source_doc,\n      subject: meta.subject,\n      doc_type: meta.doc_type,\n      uploaded_at: meta.uploaded_at,\n      chunk_index: meta.chunk_index\n    }\n  }\n}];"
      },
      "id": "prepare-doc-point",
      "name": "Prepare Qdrant Point (Doc)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, -100]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "PUT",
        "url": "https://REPLACE_WITH_QDRANT_HOST/collections/study_material/points",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ points: [$json] }) }}",
        "options": {}
      },
      "id": "upsert-doc-point",
      "name": "Upsert Point To Qdrant (Doc)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, -100],

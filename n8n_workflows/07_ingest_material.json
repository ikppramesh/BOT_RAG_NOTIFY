    {
      "parameters": {
        "jsCode": "// Diff Drive folder listing against the Ingested Files Log to find new files\nconst driveFiles = $('List Files In Study Material Folder').first().json.files || [];\nconst loggedRows = $input.all().map(i => i.json);\nconst loggedIds = new Set(loggedRows.map(r => String(r.file_id || '')));\n\nconst newFiles = driveFiles.filter(f => !loggedIds.has(f.id) && f.mimeType === 'application/pdf');\n\nif (newFiles.length === 0) return [];\n\nreturn newFiles.map(f => ({\n  json: {\n    file_id: f.id,\n    file_name: f.name,\n    ingested_at: new Date().toISOString()\n  }\n}));"
      },
      "id": "filter-new-files",
      "name": "Filter New Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },

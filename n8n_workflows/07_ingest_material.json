          "name": "Qdrant API (Header Auth)"
        }
      }
    },

    {
      "parameters": {
        "jsCode": "// Edit this list to the current-affairs feeds relevant to your syllabus.\n// Each feed is tagged with a subject so retrieved chunks can be scoped\n// (e.g. filter /ask searches to just 'Current Affairs' if desired later).\nreturn [\n  { json: { feed_url: 'https://www.thehindu.com/news/national/feeder/default.rss', subject_tag: 'Current Affairs — National' } }\n  // Add more feeds here, e.g. PIB releases, PRS India blog, Down To Earth, etc.\n  // { json: { feed_url: 'https://example.org/feed.xml', subject_tag: 'Current Affairs — Environment' } }\n];"
      },

            "Matched": "={{ $json.matched_log }}",
            "Source Docs": "={{ $json.source_docs_log }}",
            "Timestamp": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-rag-query",
      "name": "Log RAG Query",
      "type": "n8n-nodes-base.googleSheets",

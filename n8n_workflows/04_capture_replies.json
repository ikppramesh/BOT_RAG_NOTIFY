        "jsCode": "// Build Q3 productivity keyboard\nconst d = $('Validate Actual Hours Input').first().json;\n\nreturn [{\n  json: {\n    chat_id: d.chat_id,\n    text: 'Last question! How productive was today on a scale of 1 to 5?',\n    reply_markup: {\n      keyboard: [\n        [{ text: '⭐ 1' }, { text: '⭐⭐ 2' }, { text: '⭐⭐⭐ 3' }],\n        [{ text: '⭐⭐⭐⭐ 4' }, { text: '⭐⭐⭐⭐⭐ 5' }]\n      ],\n      one_time_keyboard: true,\n      resize_keyboard: true\n    }\n  }\n}];"

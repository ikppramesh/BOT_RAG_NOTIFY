    {
      "parameters": {
        "jsCode": "// Parse productivity score from tap like '⭐ 1', '⭐⭐ 2', etc.\nconst d = $input.first().json;\nconst text = d.text;\n\nconst match = text.match(/(\\d+)$/);\nconst score = match ? parseInt(match[1]) : null;\n\nif (!score || score < 1 || score > 5) {\n  return [{ json: { ...d, valid: false, error_msg: 'Please tap one of the star options (⭐ 1 through ⭐⭐⭐⭐⭐ 5).' } }];\n}\n\nconst stars = '⭐'.repeat(score);\nlet closing = '';\nif (score >= 5) closing = 'Absolutely on fire today! 🔥 Keep this energy!';\nelse if (score >= 4) closing = 'Great day! Consistency like this will pay off. 💪';\nelse if (score >= 3) closing = 'Solid effort. Push a little harder tomorrow. 💫';\nelse if (score >= 2) closing = 'Every day is a lesson. Rest and come back stronger. 🌱';\nelse closing = 'Tough day \\u2014 that is okay. Tomorrow is a fresh start. 🙏';\n\nreturn [{\n  json: {\n    ...d,\n    valid: true,\n    productivity: score,\n    closing_text: `🌙 Night report saved!\\n\\nProductivity: ${stars} (${score}/5)\\n\\n${closing}\\n\\nSee you tomorrow! 🚀`\n  }\n}];"
      },

      "parameters": {
        "jsCode": "// Parse slots from reply keyboard tap\nconst d = $input.first().json;\nconst text = d.text;\n\nconst validSlots = { '2 Slots': 2, '3 Slots': 3, '4 Slots': 4, '5 Slots': 5, '6 Slots': 6 };\nconst slotsValue = validSlots[text];\n\nif (!slotsValue) {\n  return [{ json: { ...d, valid: false, error_msg: 'Please tap one of the options: 2 Slots, 3 Slots, 4 Slots, 5 Slots, or 6 Slots.' } }];\n}\n\nreturn [{\n  json: {\n    ...d,\n    valid: true,\n    slots_target: slotsValue,\n    q2_text: `Got it! *${slotsValue} slots* targeted today. 💪\\n\\nNow, how many study hours are you aiming for?`,\n    q2_reply_markup: {\n      keyboard: [\n        [{ text: '4 Hours' }, { text: '6 Hours' }],\n        [{ text: '8 Hours' }, { text: '10+ Hours' }]\n      ],\n      one_time_keyboard: true,\n      resize_keyboard: true\n    }\n  }\n}];"
      },

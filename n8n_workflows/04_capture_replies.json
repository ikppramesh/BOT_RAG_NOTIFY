            {
              "lookupColumn": "telegram_chat_id",
              "lookupValue": "={{ $json.chat_id }}"
            }
          ]
        },
        "options": {
          "returnFirstMatch": true
        }
      },
      "id": "lookup-registry",
      "name": "Lookup Student Registry",
      "type": "n8n-nodes-base.googleSheets",

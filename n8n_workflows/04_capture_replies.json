    {
      "parameters": {
        "jsCode": "// Merge message data + registry/session data; recalculate day number\nconst msgData = $('Extract Message Data').first().json;\nconst regRows = $input.all();\n\nif (!regRows || regRows.length === 0 || !regRows[0].json || !regRows[0].json['telegram_chat_id']) {\n  // Unknown student — ignore\n  return [];\n}\n\nconst reg = regRows[0].json;\nconst expectedNext = (reg['Expected Next'] || 'none').trim();\nconst sessionDate = reg['Session Date'] || msgData.today_date;\nconst studentName = reg['student_name'] || 'Student';\n\n// Recalculate day number from start_date\nconst startDateStr = reg['start_date'] || '';\nlet dayNumber = '?';\nif (startDateStr) {\n  const parts = startDateStr.split('/');\n  let startDate;\n  if (parts.length === 3) {\n    startDate = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));\n  } else {\n    startDate = new Date(startDateStr);\n  }\n  if (!isNaN(startDate.getTime())) {\n    const diffMs = new Date() - startDate;\n    dayNumber = Math.floor(diffMs / (1000 * 60 * 60 * 24)) + 1;\n  }\n}\n\nreturn [{\n  json: {\n    chat_id: msgData.chat_id,\n    text: msgData.text,\n    today_date: msgData.today_date,\n    timestamp_ist: msgData.timestamp_ist,\n    expected_next: expectedNext,\n    session_date: sessionDate,\n    student_name: studentName,\n    day_number: dayNumber,\n    telegram_chat_id: reg['telegram_chat_id']\n  }\n}];"
      },

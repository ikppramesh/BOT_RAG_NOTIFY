    {
      "parameters": {
        "jsCode": "// Pick a random daily tip from the pool\nconst tips = [\n  \"One focused hour is worth three distracted hours.\",\n  \"Revision today saves panic tomorrow.\",\n  \"Write one answer today. Just one. That's 365 answers in a year.\",\n  \"Current Affairs is not about reading everything. It's about connecting everything.\",\n  \"The syllabus is finite. Your effort makes it infinite.\",\n  \"Don't compare your Day 30 with someone else's Day 300.\",\n  \"Even Laxmikanth was written one page at a time.\",\n  \"Consistency beats intensity. Show up every single day.\",\n  \"Your optional subject is your scoring weapon. Sharpen it daily.\",\n  \"50 MCQs a day = 18,250 in a year. Start now.\"\n];\n\nconst student = $input.first().json;\nconst randomTip = tips[Math.floor(Math.random() * tips.length)];\n\nreturn [{\n  json: {\n    ...student,\n    chat_id: String(student['telegram_chat_id']),\n    daily_tip: randomTip\n  }\n}];"
      },
